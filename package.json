{
  "name": "voicebridge",
  "version": "0.1.0",
  "description": "Local cross-device speech input bridge MVP.",
  "main": "src/agent/electron/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "agent": "node src/agent/cli.js",
    "electron:write-config": "node scripts/write-electron-config.js",
    "electron:start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "prepackage": "npm run electron:write-config",
    "premake": "npm run electron:write-config",
    "start": "node src/server/index.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "clipboardy": "^4.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "stripe": "^22.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "electron": "^42.3.0"
  },
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/",
    "forge": {
      "packagerConfig": {
        "name": "VoiceBridge Agent",
        "icon": "assets/icon",
        "prune": true,
        "download": {
          "mirrorOptions": {
            "mirror": "https://npmmirror.com/mirrors/electron/"
          }
        },
        "ignore": [
          "^/out($|/)",
          "^/hosted-pwa($|/)",
          "^/\\.superpowers($|/)",
          "^/\\.env($|\\.)",
          "^/certs($|/)",
          "^/docs($|/)",
          "^/supabase($|/)",
          "^/scripts($|/)",
          "^/src/public($|/)",
          "^/src/.*\\.test\\.js$",
          "^/package-lock\\.json$"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "linux",
            "win32"
          ]
        }
      ]
    }
  }
}
