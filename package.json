{
  "name": "voicebridge",
  "version": "0.1.3",
  "description": "Local cross-device speech input bridge MVP.",
  "main": "src/agent/electron/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "agent": "node src/agent/cli.js",
    "electron:write-config": "node scripts/write-electron-config.js",
    "electron:start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "prepackage": "npm run electron:write-config",
    "premake": "npm run electron:write-config",
    "mobile:prepare": "npm --prefix hosted-pwa run build && node mobile/scripts/prepare-web.mjs",
    "mobile:sync": "npm run mobile:prepare && npm --prefix mobile run sync",
    "start": "node src/server/index.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "clipboardy": "^4.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "stripe": "^22.2.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "electron": "^42.3.0"
  },
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/",
    "forge": {
      "packagerConfig": {
        "name": "VoiceBridge Agent",
        "icon": "assets/icon",
        "prune": true,
        "asar": true,
        "asarUnpack": [],
        "extendInfo": {
          "NSMicrophoneUsageDescription": "VoiceBridge 需要麦克风权限以接收手机端发送的语音转写文本。VoiceBridge requires microphone access to receive voice transcriptions from your phone.",
          "NSCameraUsageDescription": "VoiceBridge 需要摄像头权限以扫描配对二维码。VoiceBridge may use the camera to scan pairing QR codes."
        },
        "download": {
          "mirrorOptions": {
            "mirror": "https://npmmirror.com/mirrors/electron/"
          }
        },
        "ignore": [
          "^/out($|/)",
          "^/hosted-pwa($|/)",
          "^/\\.superpowers($|/)",
          "^/\\.env($|\\.)",
          "^/\\.wrangler($|/)",
          "^/certs($|/)",
          "^/docs($|/)",
          "^/cloudflare($|/)",
          "^/supabase($|/)",
          "^/scripts($|/)",
          "^/src/.*\\.test\\.js$",
          "^/node_modules/\\.cache($|/)",
          "^/node_modules/\\.bin($|/)",
          "^/node_modules/\\.deno($|/)",
          "^/node_modules/stripe($|/)",
          "^/node_modules/.*/\\.cache($|/)",
          "^/node_modules/.*/\\.wrangler($|/)",
          "^/node_modules/.*/\\.bin($|/)",
          "^/README\\.md$",
          "^/package-lock\\.json$",
          "^/tmp($|/)",
          "\\.md$"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "linux",
            "win32"
          ]
        }
      ]
    }
  }
}
