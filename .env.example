ASR_PROVIDER=tencent
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# Optional for the cloud Edge Function: enables FlashRecognition with automatic fallback.
TENCENT_APP_ID=
TENCENT_ASR_REGION=ap-shanghai
TENCENT_ASR_ENG_SERVICE_TYPE=16k_zh
FFMPEG_PATH=
PORT=3000
AUTO_PASTE=true

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Billing provider selection: "stripe" or "paddle" (controls new checkout routing)
BILLING_PROVIDER=stripe

# Stripe (legacy, still used when BILLING_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/?billing=cancel

# Paddle (used when BILLING_PROVIDER=paddle)
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=sandbox  # "sandbox" or "production"
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=
PADDLE_HOSTED_CHECKOUT_URL=  # e.g. https://checkout.paddle.com/checkout/custom/XXXXXXXX
PADDLE_DEFAULT_PAYMENT_LINK=  # optional, e.g. https://checkout.paddle.com/checkout/link/XXXXXXXX
PADDLE_SUCCESS_URL=https://voicebridge-6kr.pages.dev/?billing=success  # optional, has default
PADDLE_CLIENT_TOKEN=  # optional, client-side token for Paddle.js overlay (prefix: test_ in sandbox)

# Cloud mode
VOICEBRIDGE_MODE=local
VOICEBRIDGE_AGENT_EMAIL=
VOICEBRIDGE_AGENT_PASSWORD=

# Desktop app public config. These are public Supabase client values, not service secrets.
VOICEBRIDGE_DESKTOP_SUPABASE_URL=
VOICEBRIDGE_DESKTOP_SUPABASE_ANON_KEY=
